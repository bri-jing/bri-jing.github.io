# Browser JS API key, with bri-jing.com and development domains allowed in AMap.
NEXT_PUBLIC_AMAP_KEY=
# Existing local installations may continue using VITE_AMAP_KEY instead.
# Prefer a production security proxy ending in /_AMapService when available.
NEXT_PUBLIC_AMAP_SERVICE_HOST=
# Optional alternative to the proxy, per the AMap JS API configuration.
NEXT_PUBLIC_AMAP_SECURITY_CODE=
NEXT_PUBLIC_BASE_PATH=
